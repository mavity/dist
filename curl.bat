@goto windows
:windows
@echo off
:_MOHABBAT_WIN_START_
setlocal enabledelayedexpansion
set "ME=%~f0"
set "TMP_DIR=!TEMP!"
if exist ".\target" set "TMP_DIR=.\target"
set "TMP_EXE=!TMP_DIR!\moh-!RANDOM!.exe"

set "P_LEN=14834993            "
set "PLD_OFF=40186121            "
set "PLD_LEN=9915725             "
if not defined MOHABBAT_VERBOSE set "MOHABBAT_VERBOSE=0"

set "FWD_ARGS="
set "PLATFORM_OVERRIDE="
set "SKIP_NEXT="
for %%A in (%*) do (
  if defined SKIP_NEXT (
    set "PLATFORM_OVERRIDE=%%~A"
    set "SKIP_NEXT="
  ) else if "%%~A"=="--platform" (
    set "SKIP_NEXT=1"
  ) else (
    if /I "%%~A"=="-v" set "MOHABBAT_VERBOSE=1"
    if /I "%%~A"=="--verbose" set "MOHABBAT_VERBOSE=1"
    set "FWD_ARGS=!FWD_ARGS! %%A"
  )
)

set "ARCH=%PROCESSOR_ARCHITECTURE%"
if "!PROCESSOR_ARCHITEW6432!" neq "" set "ARCH=!PROCESSOR_ARCHITEW6432!"
set "S_OFF=0"
set "S_LEN=0"
set "W_OFF=0"
set "W_LEN=0"
set "RESOLVED_PLATFORM="
if "!MOHABBAT_VERBOSE!"=="1" echo [mohabbat:bat] entry: path=!ME! arch=!ARCH! platform_override=!PLATFORM_OVERRIDE! 1>&2

if defined PLATFORM_OVERRIDE (
  if "!PLATFORM_OVERRIDE!"=="node" set "RESOLVED_PLATFORM=node"
  if "!PLATFORM_OVERRIDE!"=="linux-amd64" set "RESOLVED_PLATFORM=linux-amd64"
  if "!PLATFORM_OVERRIDE!"=="linux-arm64" set "RESOLVED_PLATFORM=linux-arm64"
  if "!PLATFORM_OVERRIDE!"=="linux-arm32" set "RESOLVED_PLATFORM=linux-arm32"
  if "!PLATFORM_OVERRIDE!"=="darwin-arm64" set "RESOLVED_PLATFORM=darwin-arm64"
  if "!PLATFORM_OVERRIDE!"=="windows-amd64" set "RESOLVED_PLATFORM=windows-amd64"
  if "!PLATFORM_OVERRIDE!"=="windows-arm64" set "RESOLVED_PLATFORM=windows-arm64"
  
  if "!PLATFORM_OVERRIDE!"=="amd64" set "RESOLVED_PLATFORM=windows-amd64"
  if "!PLATFORM_OVERRIDE!"=="x64" set "RESOLVED_PLATFORM=windows-amd64"
  if "!PLATFORM_OVERRIDE!"=="arm64" set "RESOLVED_PLATFORM=windows-arm64"
  
  if "!RESOLVED_PLATFORM!"=="" (
    echo [mohabbat] Invalid --platform: !PLATFORM_OVERRIDE!
    echo [mohabbat] Available: node, linux-amd64, linux-arm64, linux-arm32, darwin-arm64, windows-amd64, windows-arm64, amd64, arm64
    exit /b 1
  )
  if "!RESOLVED_PLATFORM!"=="node" (
    set "USE_NODE=1"
    set "S_LEN=0"
  ) else if "!RESOLVED_PLATFORM!"=="windows-amd64" (
    set "S_OFF=224399"
    set "S_LEN=41984"
    set "W_OFF=20263529"
    set "W_LEN=7266304"
  ) else if "!RESOLVED_PLATFORM!"=="windows-arm64" (
    set "S_OFF=266383"
    set "S_LEN=37888"
    set "W_OFF=27529833"
    set "W_LEN=6692352"
  ) else if "!RESOLVED_PLATFORM!"=="linux-amd64" (
    set "S_OFF=62159"
    set "S_LEN=49512"
    set "W_OFF=66039"
    set "W_LEN=6967456"
  ) else if "!RESOLVED_PLATFORM!"=="linux-arm64" (
    set "S_OFF=111671"
    set "S_LEN=45384"
    set "W_OFF=7033495"
    set "W_LEN=6553760"
  ) else if "!RESOLVED_PLATFORM!"=="linux-arm32" (
    set "S_OFF=304271"
    set "S_LEN=43504"
    set "W_OFF=34222185"
    set "W_LEN=5963936"
  ) else if "!RESOLVED_PLATFORM!"=="darwin-arm64" (
    set "S_OFF=157055"
    set "S_LEN=67344"
    set "W_OFF=13587255"
    set "W_LEN=6676274"
  )
  
  if "!S_LEN!"=="0" if not "!RESOLVED_PLATFORM!"=="node" (
    echo [mohabbat] Platform '!RESOLVED_PLATFORM!' is not included in this vegetable
    exit /b 1
  )
) else (
  if "!ARCH!"=="AMD64" (
  	set "S_OFF=224399"
  	set "S_LEN=41984"
  	set "W_OFF=20263529"
  	set "W_LEN=7266304"
  ) else if "!ARCH!"=="ARM64" (
  	set "S_OFF=266383"
  	set "S_LEN=37888"
  	set "W_OFF=27529833"
  	set "W_LEN=6692352"
  )
)

set "USE_NODE=0"
if defined MOHABBAT_USE_NODE set "USE_NODE=1"
if "!S_LEN!"=="0" set "USE_NODE=1"
if "!USE_NODE!"=="1" (
  set "NODE_BIN="
  for %%c in ("node.exe") do (
    if not "%%~$PATH:c"=="" set "NODE_BIN=%%~$PATH:c"
  )
  if "!NODE_BIN!"=="" (
    for %%c in ("%ProgramFiles%\nodejs\node.exe" "%ProgramFiles(x86)%\nodejs\node.exe" "%ChocolateyInstall%\bin\node.exe" "%UserProfile%\.volta\bin\node.exe") do (
      if exist "%%~c" set "NODE_BIN=%%~c"
    )
  )
  if "!NODE_BIN!"=="" (
    for /D %%d in ("%AppData%\nvm\v*") do if exist "%%d\node.exe" set "NODE_BIN=%%d\node.exe"
  )
  if "!NODE_BIN!"=="" (
    for /D %%d in ("%UserProfile%\.fnm\node-versions\*") do if exist "%%d\installation\node.exe" set "NODE_BIN=%%d\installation\node.exe"
  )
  if not "!NODE_BIN!"=="" (
    "!NODE_BIN!" -v >nul 2>&1
    if !errorlevel! equ 0 (
      powershell -NoProfile -ExecutionPolicy Bypass -Command "& { $a=[IO.File]::ReadAllBytes($env:ME); $b=[Text.Encoding]::UTF8.GetString($a, 11917, 3807); $n=$env:NODE_BIN; $m=$env:ME; $b | & $n - $env:ME $args; exit $LASTEXITCODE }" --!FWD_ARGS!
      exit /b !errorlevel!
    )
  )
)
if "!S_LEN!"=="0" (
    echo [mohabbat] This vegetable does not support target platform on Windows and node is not available.
    exit /b 1
)
if "!MOHABBAT_VERBOSE!"=="1" echo [mohabbat:bat] platform: selected=!RESOLVED_PLATFORM! brot_offset=!S_OFF! brot_len=!S_LEN! washmhost_offset=!W_OFF! washmhost_len=!W_LEN! pool_len=!P_LEN! payload_offset=!PLD_OFF! payload_len=!PLD_LEN! 1>&2
powershell -NoProfile -ExecutionPolicy Bypass -Command "$a=[IO.File]::ReadAllBytes($env:ME); $b=New-Object byte[] !S_LEN!; [Array]::Copy($a, [int64]!S_OFF!, $b, 0, [int]!S_LEN!); [IO.File]::WriteAllBytes($env:TMP_EXE, $b)"
if "!MOHABBAT_VERBOSE!"=="1" for %%F in ("!TMP_EXE!") do echo [mohabbat:bat] brot bytes=%%~zF expected=!S_LEN! 1>&2
"!TMP_EXE!" "!ME!" "!P_LEN!" "!W_OFF!" "!W_LEN!" "!PLD_OFF!" "!PLD_LEN!"!FWD_ARGS!
set "RET=!ERRORLEVEL!"
if "!MOHABBAT_VERBOSE!"=="1" echo [mohabbat:bat] brot exit: status=!RET! 1>&2
if exist "!TMP_EXE!" del /F /Q "!TMP_EXE!" >nul 2>&1
exit /b !RET!
